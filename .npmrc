# Supply-chain hardening.
#
# ignore-scripts blocks preinstall/install/postinstall hooks in dependencies.
# That is the execution path the Shai-Hulud family of npm worms uses: a
# compromised package version runs code the moment it is installed, before
# anything is imported, and steals npm/GitHub/cloud credentials from the
# machine doing the install.
#
# Verified safe for this tree: only esbuild and @swc/core (both
# devDependencies) declare install-time scripts, and both resolve their
# prebuilt binaries from optionalDependencies without them. A full
# `npm ci --ignore-scripts` passes the entire server suite and builds both
# workspaces. `npm run <script>` is unaffected — this only disables package
# lifecycle hooks during install.
#
# If a future dependency genuinely needs its install hook, allow it
# deliberately with `npm rebuild <pkg>` rather than removing this line.
ignore-scripts=true

# New `npm install <pkg>` pins an exact version instead of a ^range, so a
# compromised patch release cannot be picked up by a later lockfile refresh.
save-exact=true

# Cooldown: only resolve versions that have been on the registry for at least
# 14 days. Hijacked releases are typically spotted and unpublished within
# hours to a couple of days, so waiting out that window is what keeps a
# Shai-Hulud-style release from ever entering the tree in the first place.
#
# Affects dependency *resolution* only (`npm install`, `npm update`).
# `npm ci` installs straight from package-lock.json and is unaffected —
# verified, since deploy.sh depends on it.
#
# Requires npm 11.6+ (ships with Node 24). Older npm ignores the key, so this
# only takes effect once the server is on Node 24.
#
# To take a genuinely urgent security release before it ages in, override for
# that one command: `npm install <pkg> --min-release-age=0`.
min-release-age=14
